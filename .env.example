# ============================================
# JC Shell - 环境配置模板
# 复制本文件为 .env.development / .env.production / .env.staging 后填写
# 说明：这些文件不入库（已被 .gitignore 忽略），每台机器/每个环境各自维护
# 覆盖：通过命令行 OPENJC_SERVER_BASE_URL=xxx 可临时覆盖编译期值
# ============================================

# OpenJC 后端服务地址（生产域名或本地地址）
OPENJC_SERVER_BASE_URL=https://www.openjc.cc

# OAuth 客户端标识（主站注册的公开客户端，非密钥）
OPENJC_CLIENT_ID=jc-shell

# OAuth 授权范围（逗号分隔）
OPENJC_SCOPES=ai,config-sync

# 客户端签名密钥（与服务端 openjc.ai.client-sign-secret 保持一致）
# 用途: 1) AI/云同步接口请求签名  2) WAF「机器级放行令牌」(JC Shell 请求永不被自家防护误拦)
# 生成: -join ([guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N'))
OPENJC_AI_SIGN_SECRET=
