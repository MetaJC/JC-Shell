{
  "name": "jc-shell-community",
  "private": true,
  "version": "0.3.3",
  "author": "OpenJC",
  "homepage": "https://www.openjc.cc",
  "repository": "https://gitee.com/Open-JC/jc-shell-community",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-xcode-env.mjs",
    "icon:build": "node scripts/icon-build.mjs",
    "icon:store": "node scripts/icon-store.mjs",
    "icon:mobile": "node scripts/icon-build.mjs",
    "tauri:dev": "node scripts/with-env.mjs .env.development -- tauri dev",
    "tauri:build:dev": "node scripts/with-env.mjs .env.development -- tauri build",
    "tauri:build:prod": "node scripts/with-env.mjs .env.production -- tauri build",
    "tauri:build:win:user": "node scripts/with-env.mjs .env.production -- tauri build",
    "tauri:build:win:sys": "node scripts/with-env.mjs .env.production -- tauri build --config src-tauri/tauri.conf.system.json",
    "tauri:build:linux:deb": "node scripts/with-env.mjs .env.production -- tauri build --bundles deb",
    "tauri:build:linux:rpm": "node scripts/with-env.mjs .env.production -- tauri build --bundles rpm",
    "tauri:build:linux:appimage": "node scripts/with-env.mjs .env.production -- tauri build --bundles appimage",
    "tauri:build:linux:all": "node scripts/with-env.mjs .env.production -- tauri build",
    "tauri:build:mac:intel": "node scripts/with-env.mjs .env.production -- tauri build --target x86_64-apple-darwin",
    "tauri:build:mac:arm": "node scripts/with-env.mjs .env.production -- tauri build --target aarch64-apple-darwin",
    "tauri:build:mac:universal": "node scripts/with-env.mjs .env.production -- tauri build --target universal-apple-darwin",
    "tauri:android:init": "tauri android init && node scripts/android-signing.mjs",
    "android:sign:setup": "node scripts/android-signing.mjs",
    "tauri:android:dev": "node scripts/with-env.mjs .env.development -- tauri android dev",
    "tauri:android:build": "node scripts/with-env.mjs .env.production -- tauri android build",
    "tauri:android:build:apk": "node scripts/with-env.mjs .env.production -- tauri android build --apk",
    "android:build:prod": "npm run tauri:android:build:apk && node scripts/android-sign-prod.mjs",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "node scripts/with-env.mjs .env.development -- tauri ios dev --no-dev-server-wait --force-ip-prompt",
    "tauri:ios:build": "node scripts/with-env.mjs .env.production -- tauri ios build --config src-tauri/tauri.ios.prod.conf.json"
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@element-plus/icons-vue": "^2.3.1",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-biometric": "^2.3.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "element-plus": "^2.8.0",
    "js-yaml": "^5.3.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.0"
  }
}
